# Copy to .env, supply credentials, and keep .env private.
MEMORY_PROFILE=C
MEMORY_API_TOKEN=replace-with-your-service-token
MEMORY_DATA=./data/C
OPENAI_API_KEY=replace-with-your-model-api-key
OPENAI_API_BASE=https://api.gpt.ge/v1
# This endpoint must support text-embedding-v4, 1024 dimensions.
# Empty values reuse the chat provider's key/base.
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
SEARCH_CONCURRENCY=1
LLM_CONCURRENCY=4
UPSTREAM_TIMEOUT=150
TIKTOKEN_CACHE_DIR=./.cache/tiktoken
MODEL_WORKER_URL=http://127.0.0.1:18220
WORKER_TOKEN=replace-with-a-separate-private-worker-token
MODEL_ROOT=./models
ENABLE_SIGLIP=0
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=2
