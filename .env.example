OPENAI_API_KEY=replace-me
OPENAI_API_BASE=https://api.gpt.ge/v1
OPENAI_MODEL=gpt-4o-mini
# Optional separate OpenAI-compatible embedding provider. Academic track requires v4.
EMBEDDING_ENABLED=true
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-v4
OPENAI_EMBEDDING_DIMENSIONS=1024
MEMORY_DB=data/memory.sqlite3
MEMORY_API_TOKEN=
LLM_CONCURRENCY=4
UPSTREAM_TIMEOUT=60
# auto: strict JSON Schema first; fallback only on explicit unsupported-format errors.
# strict: require JSON Schema; json: JSON object plus the same local normalization.
EXTRACTION_OUTPUT_MODE=auto
RETRIEVAL_LIMIT=32
NEIGHBOR_HOPS=1
GRAPH_EXPANSION=true
DIVERSITY=true
MAX_RESPONSE_IMAGES=12
MAX_RESPONSE_TEXT_CHARS=100000
