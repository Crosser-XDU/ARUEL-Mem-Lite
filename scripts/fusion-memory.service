[Unit]
Description=AUREL-Mem-Lite multimodal evidence memory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aurel-mem-lite
Environment=ENV_FILE=/opt/aurel-mem-lite/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/aurel-mem-lite/.venv/bin/python -m uvicorn fusion_memory.app:create_app --factory --host 127.0.0.1 --port 18090 --workers 1 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=240
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
