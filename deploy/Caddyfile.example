# Merge this route block into your existing HTTPS site; keep other services intact.
# This standalone example is for a local TLS-terminating proxy on the same host.
# For the deployed IP certificate and dual tunnels, see docs/deployment.md.
example.com {
    request_body {
        max_size 50331648
    }
    @memory path /add /search /healthz
    handle @memory {
        reverse_proxy 127.0.0.1:18110 {
            transport http {
                dial_timeout 3s
                response_header_timeout 30m
                read_timeout 30m
                write_timeout 30m
            }
        }
    }
    handle {
        respond 404
    }
}
